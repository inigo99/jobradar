# ---------------------------------------------------------------------------
# JobRadar environment. Copy to `.env` and fill in what you actually use.
# Every value here is optional: JobRadar runs without any of them (`--no-llm`
# mode plus the sources that need no credentials).
# ---------------------------------------------------------------------------

# --- Language model (optional) ---------------------------------------------
# provider: anthropic | openai | gemini | openai-compatible | ollama
# Set here, these override the provider chosen in the dashboard's Settings;
# leave them empty to use what the dashboard stored.
JOBRADAR_LLM_PROVIDER=
# Blank = the provider's default (e.g. gemini-3.5-flash for gemini).
JOBRADAR_LLM_MODEL=
# Models tried in order when that one is busy, retired or out of quota
# (comma-separated; `none` for no fallback). Blank = the provider's own list,
# which for gemini spreads the free tier's small per-model daily quota.
JOBRADAR_LLM_FALLBACK_MODELS=
# Base URL only for `openai-compatible` (LM Studio, vLLM, OpenRouter, ...)
# and `ollama` (defaults to http://localhost:11434/v1).
JOBRADAR_LLM_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Google AI Studio key for `gemini` (GOOGLE_API_KEY is also accepted).
GEMINI_API_KEY=

# --- PDF rendering (optional) -------------------------------------------------
# A Chromium or Chrome to print the CV with, when Playwright's own browser is
# not installed. Left empty, JobRadar looks for one by itself.
JOBRADAR_CHROMIUM_PATH=

# --- Job board API keys (optional, only for the sources you enable) --------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# --- Notifications (optional) ----------------------------------------------
JOBRADAR_SMTP_HOST=
JOBRADAR_SMTP_PORT=587
JOBRADAR_SMTP_USER=
JOBRADAR_SMTP_PASSWORD=
JOBRADAR_SMTP_FROM=
JOBRADAR_SMTP_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Replies in your inbox (optional, read-only IMAP) ----------------------
# Switch it on in Settings -> Replies in your email. Use an app password:
# Gmail  myaccount.google.com/apppasswords (host imap.gmail.com)
# Outlook  account security settings (host outlook.office365.com)
JOBRADAR_IMAP_HOST=
JOBRADAR_IMAP_USER=
JOBRADAR_IMAP_PASSWORD=
JOBRADAR_IMAP_PORT=993
# Blank = INBOX. On Gmail, "[Gmail]/All Mail" also sees archived replies.
JOBRADAR_IMAP_FOLDER=

# --- Paths (optional) -------------------------------------------------------
# Where the database, generated CVs and cache live. Defaults to ./data
JOBRADAR_HOME=
