# ---------------------------------------------------------------------------
# JobRadar environment. Copy to `.env` and fill in what you actually use.
# Every value here is optional: JobRadar runs without any of them (`--no-llm`
# mode plus the sources that need no credentials).
# ---------------------------------------------------------------------------

# --- Language model (optional) ---------------------------------------------
# provider: anthropic | openai | openai-compatible | ollama | none
JOBRADAR_LLM_PROVIDER=none
JOBRADAR_LLM_MODEL=
# Base URL only for `openai-compatible` (LM Studio, vLLM, OpenRouter, ...)
# and `ollama` (defaults to http://localhost:11434/v1).
JOBRADAR_LLM_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Job board API keys (optional, only for the sources you enable) --------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# --- Notifications (optional) ----------------------------------------------
JOBRADAR_SMTP_HOST=
JOBRADAR_SMTP_PORT=587
JOBRADAR_SMTP_USER=
JOBRADAR_SMTP_PASSWORD=
JOBRADAR_SMTP_FROM=
JOBRADAR_SMTP_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paths (optional) -------------------------------------------------------
# Where the database, generated CVs and cache live. Defaults to ./data
JOBRADAR_HOME=
